{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "See animals, villagers and other players on top of Voxy and Distant Horizons far terrain, drawn in an optimized way. Works on vanilla too: play with a minimal render and simulation distance and the horizon stays alive.",
  "authors": ["clixmods"],
  "license": "LicenseRef-LivingHorizon",
  "icon": "assets/livinghorizon/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.clixmods.livinghorizon.LivingHorizonClient"],
    "modmenu": ["fr.clixmods.livinghorizon.ui.ModMenuEntry"]
  },
  "mixins": [
    { "config": "livinghorizon.mixins.json", "environment": "client" }
  ],
  "accessWidener": "livinghorizon.accesswidener",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "voxy": "*",
    "distanthorizons": "*"
  }
}
