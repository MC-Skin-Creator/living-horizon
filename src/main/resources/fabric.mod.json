{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Gives life to the distance: animals, villagers and other players stay visible far past your render distance, players who logged off live on where they left, and birds fill the sky. Works with the game alone or on top of Voxy and Distant Horizons.",
  "authors": ["clixmods"],
  "contributors": ["JonesJugHead", "ISessen", "largitalian"],
  "contact": {
    "homepage": "https://github.com/MC-Skin-Creator/living-horizon",
    "sources": "https://github.com/MC-Skin-Creator/living-horizon",
    "issues": "https://github.com/MC-Skin-Creator/living-horizon/issues"
  },
  "license": "LicenseRef-LivingHorizon",
  "icon": "assets/livinghorizon/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["fr.clixmods.livinghorizon.LivingHorizonCommon"],
    "client": ["fr.clixmods.livinghorizon.LivingHorizonClient"],
    ${sodium}
    "modmenu": ["fr.clixmods.livinghorizon.ui.ModMenuEntry"]
  },
  "mixins": [
    "livinghorizon.mixins.json"
  ],
  "accessWidener": "livinghorizon.accesswidener",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "voxy": "*",
    "distanthorizons": "*",
    "ambientbirds": "*"
  }
}
